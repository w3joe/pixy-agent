# Gemini free tier (Google AI Studio API key)
GEMINI_FREE_API_KEY=

# Vertex AI (paid fallback) — optional; free tier works without these.
# Uncomment and set a real existing JSON path when ready:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Model (same id for free + Vertex)
GEMINI_MODEL=gemini-3.1-flash-lite

# Free-tier limits (Google changes these — tune as needed)
FREE_TIER_RPM=15
FREE_TIER_RPD=1000

# Telegram
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL Telegram will POST updates to (must be reachable by Telegram).
# Example with Tailscale Funnel: https://<magicdns>/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://your-host.example/telegram/webhook
# Optional shared secret (sent as X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# Agent behaviour
HISTORY_PERSIST_EVERY=20
HISTORY_MAX_MESSAGES=40

# API / webhook listener (0.0.0.0 if Funnel/proxy hits this process directly)
API_HOST=0.0.0.0
API_PORT=8080

# Timezone for scheduler + logs
TZ=Asia/Singapore

# Paths (relative to repo root unless absolute)
CORE_MD_PATH=core.md
MEMORY_DIR=.memory
SKILLS_DIR=skills
DATA_DIR=data

# Aspire bank API (read-only skill: skills/aspire/)
# Create key in Aspire Dashboard → Settings → Aspire API (Accounts:Read + Transactions:Read)
ASPIRE_CLIENT_ID=
ASPIRE_CLIENT_SECRET=
ASPIRE_BASE_URL=https://api.aspireapp.com/public/v1
